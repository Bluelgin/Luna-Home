# Copy as deploy/.env, chmod 600, and set a long unpredictable token.
NAPCAT_WEBUI_TOKEN=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
# Pin this image by digest or fixed release tag once tested.
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
# Match host user that owns persistent files.
NAPCAT_UID=1000
NAPCAT_GID=1000
