{
  "channels": {
    "napcat": {
      "enabled": true,
      "wsUrl": "ws://127.0.0.1:3001",
      "accessToken": "${NAPCAT_WS_TOKEN}",
      "privateOnly": true,
      "ownerQq": "REPLACE_WITH_YOUR_MAIN_QQ",
      "maxMessagesPerMinute": 30,
      "naturalChatEnabled": true,
      "replyDelayMinSeconds": 0.8,
      "replyDelayMaxSeconds": 2.5,
      "chunkDelayMinSeconds": 0.7,
      "chunkDelayMaxSeconds": 2.0,
      "maxChatChunks": 3,
      "proactiveCheckinsEnabled": false,
      "proactiveTimezone": "Asia/Shanghai",
      "proactiveStartHour": 11,
      "proactiveEndHour": 20,
      "proactiveMinIdleMinutes": 180,
      "proactiveProbability": 0.35,
      "allowFrom": ["REPLACE_WITH_YOUR_MAIN_QQ"],
      "groupPolicy": "mention",
      "welcomeNewMembers": false,
      "maxImageBytes": 10485760,
      "enableVoiceInput": false,
      "maxAudioBytes": 10485760,
      "sharedRecordDir": "/opt/luna-home/deploy/data/qq",
      "sharedRecordRemoteRoot": "/app/.config/QQ",
      "ttsModelPath": "",
      "ttsExecutable": "piper"
    }
  },
  "agents": {
    "defaults": {
      "unifiedSession": false,
      "idleCompactAfterMinutes": 15
    }
  },
  "transcription": {
    "enabled": false,
    "provider": "groq",
    "maxDurationSec": 60,
    "maxUploadMb": 10
  }
}
